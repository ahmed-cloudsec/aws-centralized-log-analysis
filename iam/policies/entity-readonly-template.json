{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyThisEntityPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::abc-security-log-archive-prod",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "entity=N/*"
          ]
        }
      }
    },
    {
      "Sid": "ReadOnlyThisEntityObjectsByPrefixAndTag",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::abc-security-log-archive-prod/entity=N/*",
      "Condition": {
        "StringEquals": {
          "s3:ExistingObjectTag/entity_id": "N",
          "s3:ExistingObjectTag/environment": "prod"
        }
      }
    }
  ]
}
