{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListAllLogPrefixes",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::abc-security-log-archive-prod"
    },
    {
      "Sid": "ReadAllLogsAcrossEntities",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::abc-security-log-archive-prod/*"
    }
  ]
}
